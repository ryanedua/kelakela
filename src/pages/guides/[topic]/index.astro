---
import { getCollection } from 'astro:content';
import Seo from '../../../components/Seo.astro';
import Shell from '../../../components/Shell.astro';

const TOPIC_LABELS: Record<string, string> = {
  baggage: 'Baggage',
  booking: 'Booking',
  'changes-cancellations': 'Changes and cancellations',
  refunds: 'Refunds',
  'delays-compensation': 'Delays and compensation',
  'check-in': 'Check-in',
  seating: 'Seating',
  loyalty: 'Loyalty',
  'special-assistance': 'Special assistance',
  pets: 'Pets',
  international: 'International',
};

const TOPIC_BLURBS: Record<string, string> = {
  baggage: 'What each carrier charges, what counts as overweight, and who gets it waived.',
  booking: 'Fare types, hold rules, and what you actually buy when you buy a ticket.',
  'changes-cancellations': 'Change fees are mostly gone. Fare difference is not, and that is the part that costs you.',
  refunds: 'When money comes back, when credit comes back instead, and when the credit expires.',
  'delays-compensation': 'What US carriers owe you when a flight runs late, and what they merely offer.',
  'check-in': 'Cutoffs, no-show rules, and what happens if you miss them.',
  seating: 'Assignment, basic economy restrictions, and families sitting together.',
  loyalty: 'Earning, expiry, and what a merger does to a balance.',
  'special-assistance': 'Wheelchairs, medical equipment, and unaccompanied minors.',
  pets: 'In-cabin, in-hold, and the rules that vary most between carriers.',
  international: 'Rules that change once you leave US jurisdiction.',
};

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft && !data.noindex);

  // Only build hubs for topics that actually have guides. An empty hub is a
  // crawl trap and it advertises a gap.
  const topics = [...new Set(guides.map((g) => g.data.topic))];

  return topics.map((topic) => ({
    params: { topic },
    props: {
      topic,
      guides: guides
        .filter((g) => g.data.topic === topic)
        .sort((a, b) => +b.data.updated - +a.data.updated),
    },
  }));
}

const { topic, guides } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });

const newest = guides.reduce((m, g) => (+g.data.updated > +m ? g.data.updated : m), new Date(0));
const label = TOPIC_LABELS[topic];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={`${label} — Airline Rules and Guides`}
      description={`${TOPIC_BLURBS[topic]} Guides covering ${label.toLowerCase()} across six US carriers, each with the date it was last checked.`.slice(0, 160)}
      published={new Date('2026-07-01')}
      updated={newest}
    />
  </head>
  <body>
    <Shell section="guides">
      <div class="hub">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/guides/">Guides</a>
        </nav>

        <h1>{label}</h1>
        <p class="lede">{TOPIC_BLURBS[topic]}</p>

        <ul>
          {guides.map((g) => (
            <li>
              <div>
                <a href={`/guides/${g.slug}/`}>{g.data.title}</a>
                <p>{g.data.verdict}</p>
              </div>
              <span class="date">{fmt(g.data.updated)}</span>
            </li>
          ))}
        </ul>
      </div>
    </Shell>

    <style>
      .hub h1 {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 5vw, 2.4rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        color: var(--navy);
        margin: 0 0 0.5rem;
      }
      .lede {
        font-size: 1.08rem;
        line-height: 1.6;
        max-width: 56ch;
        margin: 0 0 2.25rem;
      }
      .hub ul { list-style: none; margin: 0; padding: 0; }
      .hub li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1.25rem;
        padding: 0.9rem 0;
        border-bottom: 0.5px solid var(--rule-soft);
      }
      .hub li > div { min-width: 0; }
      .hub a {
        font-family: var(--font-display);
        font-size: 1.02rem;
        font-weight: 500;
        color: var(--navy);
        text-decoration: none;
        line-height: 1.35;
      }
      .hub a:hover { text-decoration: underline; }
      .hub p {
        font-size: 0.88rem;
        line-height: 1.5;
        color: var(--slate);
        margin: 0.3rem 0 0;
        max-width: 62ch;
      }
      .date {
        font-family: var(--font-utility);
        font-size: 0.66rem;
        color: var(--slate);
        white-space: nowrap;
      }
      @media (max-width: 560px) {
        .hub li { flex-direction: column; gap: 0.35rem; }
      }
    </style>
  </body>
</html>
