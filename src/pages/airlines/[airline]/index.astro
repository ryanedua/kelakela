---
import { getCollection } from 'astro:content';
import Seo from '../../../components/Seo.astro';
import Shell from '../../../components/Shell.astro';
import { hasVerifiedData, parseVerified, verifiedBlocks } from '../../../data/verified';

const TOPIC_LABELS: Record<string, string> = {
  baggage: 'Baggage',
  'changes-cancellations': 'Changes and cancellations',
  refunds: 'Refunds',
  'delays-compensation': 'Delays and compensation',
  'check-in': 'Check-in',
  seating: 'Seating',
  pets: 'Pets',
};

export async function getStaticPaths() {
  const files = import.meta.glob<Record<string, any>>('../../../data/airlines/*.json', {
    eager: true,
  });
  const policies = await getCollection('policies', ({ data }) => !data.draft && !data.noindex);
  const guides = await getCollection('guides', ({ data }) => !data.draft && !data.noindex);

  /** A carrier earns a page once at least one figure has actually been checked.
   *  Scaffolded files (every `verified` null) are placeholders for the author,
   *  not pages for readers — publishing them would ship thin, empty pages that
   *  Google indexes and holds against the whole site.
   *
   *  This used to test `b.verified` for truthiness, which passed the string
   *  "null" and shipped a page reading "Invalid Date". Parse, don't trust. */
  return Object.values(files)
    .map((mod: any) => mod.default ?? mod)
    .filter(hasVerifiedData)
    .map((data) => ({
      params: { airline: data.slug },
      props: {
        data,
        policies: policies.filter((p) => p.data.airline === data.slug),
        guides: guides.filter((g) => g.data.airlines.includes(data.slug)),
      },
    }));
}

const { data, policies, guides } = Astro.props;

const fmt = (d: string | Date) =>
  new Date(d).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });

// Same rule as the homepage board: a data block only earns a link if the
// policy page rendering it actually exists.
const pageExists = new Set(policies.map((p) => p.data.topic));

const blocks = verifiedBlocks(data)
  .map(([key, b]: [string, any]) => {
    const topic = key === 'changesCancellations' ? 'changes-cancellations' : key;
    const verified = parseVerified(b.verified)!;
    return {
      key,
      topic,
      label: b.label,
      verified: b.verified as string,
      age: Math.floor((Date.now() - verified.getTime()) / 86_400_000),
      href: pageExists.has(topic) ? `/airlines/${data.slug}/${topic}/` : null,
    };
  })
  .sort((a, b) => b.age - a.age);

const newest = policies.length
  ? policies.reduce((m, p) => (+p.data.updated > +m ? p.data.updated : m), new Date(0))
  : new Date();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={`${data.name} Policies — Fees and Rules, Checked and Dated`}
      description={`${data.name} baggage fees, change rules, and refund policy. Every figure carries the date it was last checked against ${data.name}'s own published page.`.slice(0, 160)}
      published={new Date('2026-07-01')}
      updated={newest}
    />
  </head>
  <body>
    <Shell section="airlines">
      <div class="hub">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/airlines/">Airlines</a>
        </nav>

        <h1>{data.name}</h1>

        {blocks.length > 0 && (
          <section class="checks" aria-labelledby="checks-h">
            <h2 id="checks-h">Last checked</h2>
            <ul>
              {blocks.map((b) => (
                <li>
                  {b.href ? <a href={b.href}>{b.label}</a> : <span class="checks__pending">{b.label}</span>}
                  <span class={`checks__date checks__date--${b.age > 180 ? 'crit' : b.age > 90 ? 'warn' : 'ok'}`}>
                    {fmt(b.verified)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p class="official">
          <a href={data.officialSite} rel="nofollow noopener" target="_blank">
            {data.name}'s own site
          </a>
        </p>

        {guides.length > 0 && (
          <section class="related" aria-labelledby="g-h">
            <h2 id="g-h">Guides mentioning {data.name}</h2>
            <ul>
              {guides.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}/`}>{g.data.title}</a>
                  <span class="related__date">{fmt(g.data.updated)}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </Shell>

    <style>
      .hub h1 {
        font-family: var(--font-display);
        font-size: clamp(1.8rem, 5vw, 2.4rem);
        font-weight: 600;
        letter-spacing: -0.025em;
        color: var(--navy);
        margin: 0 0 1.5rem;
      }

      .checks {
        background: var(--navy);
        border-radius: 2px;
        padding: 1.35rem;
        margin-bottom: 1.25rem;
      }
      .checks h2 {
        font-family: var(--font-utility);
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        font-weight: 400;
        color: var(--amber);
        margin: 0 0 0.75rem;
      }
      .checks ul { list-style: none; margin: 0; padding: 0; }
      .checks li {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.55rem 0;
        border-bottom: 1px solid rgb(247 245 240 / 0.12);
      }
      .checks li:last-child { border-bottom: 0; }
      .checks a { color: var(--paper); text-decoration: none; font-size: 0.95rem; }
      .checks a:hover { text-decoration: underline; }
      .checks__pending { color: var(--slate); font-size: 0.95rem; }
      .checks__date {
        font-family: var(--font-utility);
        font-variant-numeric: tabular-nums;
        font-size: 0.7rem;
        white-space: nowrap;
      }
      .checks__date--ok { color: var(--slate); }
      .checks__date--warn { color: #f0a020; }
      .checks__date--crit { color: var(--red); }

      .official {
        font-family: var(--font-utility);
        font-size: 0.7rem;
        margin: 0 0 2.5rem;
      }
      .official a { color: var(--slate); }
    </style>
  </body>
</html>
