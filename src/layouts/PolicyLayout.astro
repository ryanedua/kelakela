---
/**
 * Policy layout — reference, data-first.
 *
 * The inverse of a guide. Here the PolicyData card IS the page; prose exists
 * only to explain what the numbers don't. No verdict block, no TOC — nobody
 * scans a fee table's table of contents.
 *
 * These pages will not outrank the airline for "delta baggage fees" and they
 * are not built to. They exist to hold the verified data, to be the link
 * target guides point at, and to prove topical depth per carrier.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Seo from '../components/Seo.astro';
import Shell from '../components/Shell.astro';
import PolicyData from '../components/PolicyData.astro';
import { SITE } from '../data/site';

interface Props {
  entry: CollectionEntry<'policies'>;
  airlineData: Record<string, any>;
}

const { entry, airlineData } = Astro.props;
const d = entry.data;

const TOPIC_LABELS: Record<string, string> = {
  baggage: 'Baggage',
  'changes-cancellations': 'Changes and cancellations',
  refunds: 'Refunds',
  'delays-compensation': 'Delays and compensation',
  'check-in': 'Check-in',
  seating: 'Seating',
  pets: 'Pets',
};

const block = airlineData[d.dataKey];
if (!block) {
  throw new Error(
    `${entry.slug}: dataKey "${d.dataKey}" not found in ${d.airline}.json. ` +
    `Available: ${Object.keys(airlineData).join(', ')}`
  );
}

const fmt = (dt: Date) =>
  dt.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });

// Guides that mention this airline — the reason policy pages earn their keep.
const guides = await getCollection('guides', ({ data }) => !data.draft);
const related = guides
  .filter((g) => g.data.airlines.includes(d.airline as any) || g.data.airlines.length === 0)
  .filter((g) => g.data.topic === d.topic || g.data.topic.startsWith(d.topic))
  .slice(0, 4);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Airlines', item: `${SITE.origin}/airlines/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: airlineData.name,
      item: `${SITE.origin}/airlines/${d.airline}/`,
    },
    { '@type': 'ListItem', position: 3, name: TOPIC_LABELS[d.topic] },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={d.title}
      description={d.description}
      published={d.published}
      updated={d.updated}
      canonical={d.canonical}
      noindex={d.noindex}
      faq={d.faq}
      sources={d.sources}
    />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
  </head>

  <body>
    <Shell section="airlines">
      <article class="policy">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/airlines/">Airlines</a>
          <span aria-hidden="true">/</span>
          <a href={`/airlines/${d.airline}/`}>{airlineData.name}</a>
        </nav>

        <h1>{d.heading ?? d.title}</h1>

        <p class="standfirst">{d.description}</p>

        <div class="meta">
          <span>Updated {fmt(d.updated)}</span>
          <span aria-hidden="true">·</span>
          <span>Checked against {airlineData.name}'s page {fmt(d.verifiedAgainstSource)}</span>
        </div>

        {/* The signature element. Every figure arrives dated and sourced. */}
        <PolicyData
          label={block.label}
          rows={block.rows}
          verified={block.verified}
          sourceUrl={block.sourceUrl}
          policyEffective={block.policyEffective}
          caveats={block.caveats}
          airlineName={airlineData.name}
        />

        <div class="prose">
          <slot />
        </div>

        <section class="sources" aria-labelledby="sources-h">
          <h2 id="sources-h">Sources</h2>
          <ul>
            {d.sources.map((s) => (
              <li>
                <a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a>
                <span class="sources__date">retrieved {fmt(s.retrieved)}</span>
              </li>
            ))}
          </ul>
        </section>

        {related.length > 0 && (
          <aside class="related" aria-labelledby="related-h">
            <h2 id="related-h">Guides on this</h2>
            <ul>
              {related.map((g) => (
                <li>
                  <a href={`/guides/${g.slug}/`}>{g.data.title}</a>
                  <span class="related__date">{fmt(g.data.updated)}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </article>
    </Shell>

    <style>
      .policy h1 {
        font-family: var(--font-display);
        font-size: clamp(1.7rem, 4.2vw, 2.2rem);
        font-weight: 600;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--navy);
        margin: 0 0 0.7rem;
        max-width: 20ch;
      }

      .standfirst {
        font-size: 1.08rem;
        line-height: 1.6;
        color: var(--ink);
        margin: 0 0 1.1rem;
        max-width: 60ch;
      }
    </style>
  </body>
</html>
